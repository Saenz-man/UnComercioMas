----------------------------------------------------
1. DEPENDENCIAS Y ARTEFACTOS DE BUILD
----------------------------------------------------

# Directorio de módulos de Node.js
/node_modules

# Directorios de compilación de TypeScript o build
/dist
/build

----------------------------------------------------
2. ARCHIVOS DE CONFIGURACIÓN SENSIBLE Y DE ENTORNO
----------------------------------------------------

# Variables de entorno (¡CRÍTICO! Contiene JWT_SECRET, DB_PASSWORD)
.env*

----------------------------------------------------
3. ARCHIVOS DE REGISTRO Y CACHE
----------------------------------------------------

# Registros de npm/yarn/pnpm y logs de la aplicación
.log
npm-debug.log
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs

# Directorios temporales
.temp
.tmp

# Datos de runtime
pids
*.pid
*.seed
*.pid.lock

----------------------------------------------------
4. SISTEMA OPERATIVO Y PRUEBAS
----------------------------------------------------

# Archivos de caché del SO
.DS_Store

# Cobertura de pruebas
/coverage
/.nyc_output
/.jest/

# Archivos de diagnóstico de Node.js
report.[0-9].[0-9].[0-9].[0-9].json

----------------------------------------------------
5. CONFIGURACIÓN DE EDITORES E IDEs
----------------------------------------------------

# Directorio de configuración de VS Code
.vscode/

# Excepciones para archivos compartidos en el equipo
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Otros IDEs y editores
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.bash_history
.zsh_history

----------------------------------------------------
6. ARCHIVOS DE SUBIDAS, IMÁGENES Y BASURA
----------------------------------------------------

# Archivos de uploads que no quieres subir
/uploads/*.png
/uploads/*.jpg
/uploads/*.jpeg
/uploads/*.gif
/uploads/*.webp
/uploads/*.svg
/uploads/*.pdf
/uploads/*.zip
/uploads/*.tmp

# Directorios temporales de uploads
/uploads/temp/
